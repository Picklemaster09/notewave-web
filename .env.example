# Frontend environment configuration (Vite).
# Only VITE_-prefixed variables are exposed to the browser. NEVER put server
# secrets (Gemini keys, Supabase service role key, Auth0 client secret) here —
# those belong on the backend API.

# Backend API origin (AI transcription + Supabase-backed data). Defaults to the
# production API if unset; override for local/staging.
VITE_API_BASE_URL=""

# Landing vs app split (optional).
# Empty (default): same-origin path mode — landing at the site root, app at "/app".
# Set to a separate origin to switch to subdomain mode (landing on root domain,
# dashboard on the app subdomain). Example: VITE_APP_URL="https://app.yourdomain.com"
VITE_APP_URL=""

# Auth0 (direct, client-side login via the SPA SDK).
# Create a "Single Page Application" in the Auth0 dashboard and copy these.
VITE_AUTH0_DOMAIN=""
VITE_AUTH0_CLIENT_ID=""
# The API identifier (audience) your backend validates access tokens against.
VITE_AUTH0_AUDIENCE=""
